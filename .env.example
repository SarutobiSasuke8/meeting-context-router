NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4300
# Required when NODE_ENV=production. Send as Authorization: Bearer <token>.
MEETING_ROUTER_API_TOKEN=
# Required to enable the Fathom webhook route in production.
FATHOM_WEBHOOK_SECRET=
FATHOM_WEBHOOK_TOLERANCE_SECONDS=300
MEETING_ROUTER_STATE_PATH=./data/state.json
# Approved directory only. Relative paths are resolved from the repository root.
OBSIDIAN_OUTPUT_ROOT=./data/outbox/obsidian
# Direct CRM adapter. No arbitrary per-request destination URLs are accepted.
CRM_BASE_URL=http://127.0.0.1:4100
CRM_API_TOKEN=
# The current Agent CRM does not yet expose a meeting/activity route.
CRM_MEETING_ACTIVITY_PATH=
