NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4300
# Required when NODE_ENV=production. Send as Authorization: Bearer <token>.
MEETING_ROUTER_API_TOKEN=
# Required to enable the Fathom webhook route in production.
FATHOM_WEBHOOK_SECRET=
FATHOM_API_KEY=
FATHOM_WEBHOOK_TOLERANCE_SECONDS=300
FIREFLIES_WEBHOOK_SECRET=
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_TOLERANCE_SECONDS=300
GRANOLA_API_KEY=
MEETING_ROUTER_STATE_PATH=./data/state.json
# Approved directory only. Relative paths are resolved from the repository root.
OBSIDIAN_OUTPUT_ROOT=./data/outbox/obsidian
# Direct CRM adapter. No arbitrary per-request destination URLs are accepted.
CRM_BASE_URL=http://127.0.0.1:4100
CRM_API_TOKEN=
# The current Agent CRM does not yet expose a meeting/activity route.
CRM_MEETING_ACTIVITY_PATH=
# Optional generic outbound webhook (n8n, Zapier, custom consumer). When set, each
# new meeting also gets a webhook proposal; approved ones are POSTed here, signed
# with HMAC-SHA256. Non-loopback URLs must use https. The secret is required with
# the URL and must be at least 32 characters (e.g. openssl rand -hex 32).
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
OUTBOUND_WEBHOOK_TIMEOUT_MS=10000
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=3
OUTBOUND_WEBHOOK_BACKOFF_MS=1000
OUTBOUND_WEBHOOK_BACKOFF_MAX_MS=30000
