{
  "name": "@meeting-context-router/mcp",
  "version": "0.1.0",
  "description": "Stdio MCP client for a Meeting Context Router API",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "files": ["dist/stdio.js", "dist/LICENSE"],
  "type": "module",
  "main": "./dist/stdio.js",
  "bin": { "meeting-context-router-mcp": "./dist/stdio.js" },
  "scripts": {
    "dev": "tsx src/stdio.ts",
    "prepack": "pnpm --filter @meeting-context-router/core build && esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node22 --external:@modelcontextprotocol/server --external:zod --outfile=dist/stdio.js && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'dist/LICENSE')\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@meeting-context-router/core": "workspace:*",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5"
  }
}
