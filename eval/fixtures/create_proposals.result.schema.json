{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "meeting_router_create_proposals result",
  "type": "object",
  "required": ["data"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["meetingId", "proposalIds", "duplicate"],
      "additionalProperties": false,
      "properties": {
        "meetingId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "proposalIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
        },
        "duplicate": { "type": "boolean" }
      }
    }
  }
}
